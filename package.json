{
  "name": "biggi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host --port 5173",
    "dev:netlify": "npx netlify dev",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit",
    "depcheck": "npx npm-check-updates -u && npm install",
    "test": "vitest run",
    "test:ci": "jest --config jest.config.cjs --runInBand --coverage",
    "preview": "vite preview",
    "preview:host": "vite preview --host --port 4173",
    "check:abis": "node scripts/check-abis.js",
    "check:contracts": "node scripts/check-contracts.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@supabase/supabase-js": "^2.89.0",
    "@walletconnect/ethereum-provider": "^2.23.1",
    "@walletconnect/modal": "^2.7.0",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "busboy": "^1.6.0",
    "clipboard-copy": "^4.0.1",
    "date-fns": "^4.1.0",
    "ethers": "^6.16.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.24.0",
    "i18next": "^25.7.3",
    "ioredis": "^5.9.0",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.6.0",
    "playwright": "^1.57.0",
    "preact": "^10.28.1",
    "process": "^0.11.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.1",
    "react-is": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@graphprotocol/graph-cli": "^0.98.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-jest": "^30.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "vite": "^7.3.0",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-node-polyfills": "^0.24.0",
