{
  "name": "biggi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host --port 5173",
    "dev:netlify": "npx netlify dev",
    "build": "vite build",
    "android:prune-assets": "node scripts/android-prune-assets.mjs",
    "android:sync": "npx cap sync android && npm run android:prune-assets",
    "android:run": "npm run android:sync && npx cap run android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:build:release": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:ci": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --quiet",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "typecheck": "node scripts/typecheck.mjs",
    "audit": "npm audit",
    "depcheck": "npx npm-check-updates -u && npm install",
    "test": "vitest run",
    "test:ci": "jest --config jest.config.cjs --runInBand --coverage",
    "preview": "vite preview",
    "preview:host": "vite preview --host --port 4173",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "npm audit --audit-level=high && npm --prefix biggi-project/bekend audit --audit-level=high && npm --prefix public-repo audit --audit-level=high",
    "check:abis": "node scripts/check-abis.js",
    "check:contracts": "node scripts/check-contracts.js",
    "check:rpc": "node scripts/check-rpc-health.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@noble/hashes": "^2.0.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@sentry/node": "^7.120.4",
    "@sentry/react": "^7.120.4",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@walletconnect/ethereum-provider": "^2.23.1",
    "@walletconnect/modal": "^2.7.0",
    "aes-js": "^4.0.0-beta.5",
    "axios": "^1.13.2",
    "baseline-browser-mapping": "^2.10.42",
    "bech32": "^2.0.0",
    "bn.js": "^5.2.2",
    "buffer": "^6.0.3",
    "busboy": "^1.6.0",
    "caniuse-lite": "^1.0.30001800",
    "clipboard-copy": "^4.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.24.0",
    "hash.js": "^1.1.7",
    "i18next": "^25.7.3",
    "ioredis": "^5.9.0",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.6.0",
    "playwright": "^1.57.0",
    "playwright-core": "^1.57.0",
    "preact": "^10.28.1",
    "process": "^0.11.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.1",
    "react-is": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "scrypt-js": "^3.0.1",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@typescript-eslint/typescript-estree": "^8.52.0",
    "@vitejs/plugin-react": "^6.1.0",
