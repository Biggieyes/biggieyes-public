    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "hardhat": "^3.1.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "solc": "^0.8.33",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-node-polyfills": "^0.2.0",
    "vitest": "^4.0.16"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "8.21.3",
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "description": "BiggiEyes mainnet frontend for Polygon NFT minting, rewards, and tokenomics.",
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
