+// Example Redis-backed token-bucket limiter (requires `ioredis` dependency)
+const IORedis = require('ioredis');
+
+module.exports = function createRedisRateLimiter(redisUrl, { key = 'pinata_rl', capacity = 10, refillMs = 60000 } = {}) {
+  const redis = new IORedis(redisUrl);
+
+  // token bucket implemented with atomic Redis Lua script
+  const lua = `
+  local key = KEYS[1]
+  local now = tonumber(ARGV[1])
+  local capacity = tonumber(ARGV[2])
+  local refill_ms = tonumber(ARGV[3])
+  local tokens_key = key .. ':tokens'
+  local ts_key = key .. ':ts'
+
+  local tokens = tonumber(redis.call('get', tokens_key) or capacity)
+  local last = tonumber(redis.call('get', ts_key) or now)
+  local elapsed = math.max(0, now - last)
+  local add = math.floor(elapsed / refill_ms * capacity)
+  if add > 0 then
+    tokens = math.min(capacity, tokens + add)
+    redis.call('set', tokens_key, tokens)
+    redis.call('set', ts_key, now)
+  end
+  if tokens <= 0 then
+    return 0
+  end
+  redis.call('decr', tokens_key)
+  return 1
+  `;
+
+  return async function allowOnce(id = '') {
+    const keyName = `${key}:${id}`;
+    try {
+      const now = Date.now();
+      const res = await redis.eval(lua, 1, keyName, now, capacity, refillMs);
+      return Number(res) === 1;
+    } catch (e) {
+      // on error, fail open (allow) to avoid breaking availability — log server-side
+      console.error('redis rate limiter error', e);
+      return true;
+    }
+  };
+
+};

